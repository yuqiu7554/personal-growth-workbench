{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人成长工作台",
  "version": "0.1.0",
  "identifier": "com.personal.growthworkbench",
  "build": {
    "frontendDist": "../workbench-prototype"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "个人成长工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self' data:; connect-src 'self' https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "本地优先的个人成长、学习与科研工作台",
    "longDescription": "用于目标规划、任务管理、英语学习、科研项目、健康记录和复盘的本地优先桌面应用。"
  }
}
